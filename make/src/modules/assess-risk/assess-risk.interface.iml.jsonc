              { "name": "anycast", "type": "boolean", "label": "Anycast" },
              { "name": "data_version", "type": "text", "label": "Data version" }
            ]
          }
        ]
      }
    ]
  },
  { "name": "ruleset", "type": "text", "label": "Rule set version" },
  { "name": "cost", "type": "text", "label": "Cost (USD)" },
