              { "name": "longitude", "type": "number", "label": "Longitude" },
              { "name": "accuracy_km", "type": "uinteger", "label": "Accuracy (km)" },
              { "name": "timezone", "type": "text", "label": "Time zone" },
              { "name": "asn", "type": "uinteger", "label": "ASN" },
              { "name": "as_org", "type": "text", "label": "Network (AS organization)" },
