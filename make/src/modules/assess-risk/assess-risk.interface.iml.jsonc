            "spec": [
              { "name": "status", "type": "text", "label": "Status" },
              { "name": "email", "type": "text", "label": "Email address" },
              { "name": "result", "type": "text", "label": "Result" },
              { "name": "deliverable", "type": "boolean", "label": "Deliverable" },
              { "name": "did_you_mean", "type": "text", "label": "Did you mean" },
              { "name": "user", "type": "text", "label": "User (before the @)" },
              { "name": "domain", "type": "text", "label": "Domain" },
              { "name": "code", "type": "uinteger", "label": "Result code" },
              { "name": "verdict", "type": "text", "label": "Verdict" },
              { "name": "reason", "type": "text", "label": "Reason" },
              { "name": "suggested_action", "type": "text", "label": "Suggested action" },
