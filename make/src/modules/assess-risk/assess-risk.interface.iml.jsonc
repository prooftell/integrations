          { "name": "status", "type": "text", "label": "Status" },
          { "name": "reason", "type": "text", "label": "Reason" },
          { "name": "cost", "type": "text", "label": "Cost (USD)" },
          {
            "name": "result",
            "type": "collection",
            "label": "Result",
            "spec": [
              { "name": "status", "type": "text", "label": "Status" },
              { "name": "phone", "type": "text", "label": "Phone number" },
              { "name": "valid", "type": "boolean", "label": "Valid" },
              { "name": "reason", "type": "text", "label": "Reason (when not valid)" },
              { "name": "line_type", "type": "text", "label": "Line type" },
              { "name": "shortcode_cost", "type": "text", "label": "Short code cost" },
              { "name": "region", "type": "text", "label": "Region" },
              { "name": "country", "type": "text", "label": "Country" },
              { "name": "country_code", "type": "text", "label": "Country code" },
              { "name": "country_prefix", "type": "text", "label": "Calling code" },
              { "name": "international_format", "type": "text", "label": "International format" },
              { "name": "national_format", "type": "text", "label": "National format" },
              { "name": "e164", "type": "text", "label": "E.164" },
              { "name": "original_carrier", "type": "text", "label": "Original carrier" },
              { "name": "timezone", "type": "array", "label": "Time zones", "spec": { "type": "text", "label": "Time zone" } },
              { "name": "geographical", "type": "boolean", "label": "Geographical" }
            ]
          }
        ]
      },
      {
        "name": "email",
        "type": "collection",
        "label": "Email",
        "spec": [
