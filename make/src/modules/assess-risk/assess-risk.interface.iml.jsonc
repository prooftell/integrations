      { "name": "code", "type": "text", "label": "Code" },
      { "name": "points", "type": "integer", "label": "Points" },
      { "name": "message", "type": "text", "label": "Message" }
    ]
  },
  {
    "name": "signals",
    "type": "collection",
    "label": "Signals",
    "spec": [
      {
        "name": "phone",
        "type": "collection",
        "label": "Phone",
