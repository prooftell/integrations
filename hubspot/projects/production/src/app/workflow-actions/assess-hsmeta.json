    "isPublished": true,
    "supportedClients": [
      {
        "client": "WORKFLOWS"
      }
    ],
    "objectTypes": [
      "0-1"
    ],
    "inputFields": [
      {
        "typeDefinition": {
          "name": "phone",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": [
          "OBJECT_PROPERTY"
        ],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "email",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": [
          "OBJECT_PROPERTY"
        ],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "ip",
