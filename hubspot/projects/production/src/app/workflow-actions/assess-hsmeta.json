        ],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "country",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": [
          "STATIC_VALUE"
        ],
        "isRequired": false
      },
      {
        "typeDefinition": {
          "name": "reference",
          "type": "string",
          "fieldType": "text"
        },
        "supportedValueTypes": [
          "STATIC_VALUE"
        ],
        "isRequired": false
      }
    ],
    "outputFields": [
      {
        "typeDefinition": {
          "name": "score",
          "type": "number",
          "fieldType": "number"
        }
      },
      {
        "typeDefinition": {
          "name": "verdict",
          "type": "string",
          "fieldType": "text"
        }
      },
      {
        "typeDefinition": {
          "name": "reasons",
          "type": "string",
          "fieldType": "text"
        }
      },
      {
        "typeDefinition": {
          "name": "assessment_id",
          "type": "string",
          "fieldType": "text"
        }
      },
      {
        "typeDefinition": {
          "name": "cost",
          "type": "string",
          "fieldType": "text"
        }
      },
      {
        "typeDefinition": {
          "name": "prooftell_error",
          "type": "string",
          "fieldType": "text"
        }
      }
    ],
    "executionRules": [
      {
        "labelName": "not_connected",
        "conditions": {
          "prooftell_error": [
            "not_connected"
          ]
        }
      },
      {
        "labelName": "insufficient_balance",
        "conditions": {
          "prooftell_error": [
            "insufficient_balance"
          ]
        }
      },
      {
        "labelName": "organization_suspended",
        "conditions": {
          "prooftell_error": [
            "organization_suspended"
          ]
        }
      },
      {
        "labelName": "payment_disputed",
        "conditions": {
          "prooftell_error": [
            "payment_disputed"
          ]
        }
      },
      {
        "labelName": "staging_restricted",
        "conditions": {
          "prooftell_error": [
            "staging_restricted"
          ]
        }
      },
      {
        "labelName": "invalid_phone",
        "conditions": {
          "prooftell_error": [
            "invalid_phone"
          ]
        }
      },
      {
        "labelName": "invalid_email",
        "conditions": {
          "prooftell_error": [
            "invalid_email"
          ]
        }
      },
      {
        "labelName": "invalid_ip",
        "conditions": {
          "prooftell_error": [
            "invalid_ip"
          ]
        }
      },
      {
        "labelName": "invalid_country",
        "conditions": {
          "prooftell_error": [
            "invalid_country"
          ]
        }
      },
      {
        "labelName": "invalid_level",
        "conditions": {
          "prooftell_error": [
            "invalid_level"
          ]
        }
      },
      {
        "labelName": "invalid_reference",
        "conditions": {
